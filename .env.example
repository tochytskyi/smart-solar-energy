# Copy to .env and fill in. The container reads these as environment variables;
# nothing is baked into the image.

# TP-Link / Tapo cloud account (the one the plugs are registered to)
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# The one plug this program controls.
PLUG_B_IP=192.168.0.239

# The image docker compose pulls - your GHCR build of this repository.
# TAPO_IMAGE=ghcr.io/your-github-username/tapo:latest

# Seconds between decision passes.
CHECK_INTERVAL=60

# ---------------------------------------------------------------------------
# Cheap-tariff night window. The socket is only ever switched on inside it.
# ---------------------------------------------------------------------------
NIGHT_START=00:00
NIGHT_END=07:00

# The top-up window. From SOLAR_START the socket runs until the plug's meter
# says the load has had its DEVICE_DAILY_KWH - on roof where there is roof and
# grid where there is not.
SOLAR_START=10:00
SOLAR_END=18:00

# forecast = energy balance (recommended). rain = boost whenever the middle of
# the day is forecast mostly wet, without counting the kilowatts.
BOOST_STRATEGY=forecast

# ---------------------------------------------------------------------------
# The load and the house. Only the forecast strategy does arithmetic with these.
# ---------------------------------------------------------------------------
# What the device on the socket needs per day. The plug's own meter stops the
# boost once it has had this much, so set it to 0 to run the whole window.
DEVICE_DAILY_KWH=6
# The same ration measured by the clock, and the first of the two to fill ends
# the day. The load has its own thermostat: on a day nobody drew hot water it
# cuts out, the meter barely moves, and a kWh-only brake would hold the socket
# closed for the whole window waiting for energy the load will never take.
# Set it to DEVICE_DAILY_KWH / DEVICE_POWER_KW to mean the same ration both
# ways (6 kWh at 2 kW = 3 h); lower to cap the clock harder. 0 switches the
# clock off and leaves the meter alone in charge.
DEVICE_DAILY_HOURS=3
# What it draws while it is on. `python check.py` prints the socket's live
# power - run it with the device heating and put that figure here. Used to warn
# at startup when NIGHT_START-NIGHT_END is too short to deliver
# DEVICE_DAILY_KWH through the load, and to size DEVICE_DAILY_HOURS against it.
DEVICE_POWER_KW=2.0
# What the REST of the house takes out of the roof over the solar window,
# excluding that device. This is the one number here that is a guess - take a
# few days of daytime consumption, subtract the device, and add whatever the
# battery charges from solar, since that is roof the load cannot have either.
# Subtracted from the day's forecast total to size the night's grid buy.
HOUSE_DAYTIME_KWH=8

# ---------------------------------------------------------------------------
# Blackout mode, for seasons of scheduled outages. During an outage the house
# runs on its battery, so a night "grid buy" would really drain the battery
# into the load. On, the night window buys only while the sentinel below
# answers on the LAN. The day top-up is not affected.
# ---------------------------------------------------------------------------
# 1 to switch it on, 0 to leave the night deciding on the forecast alone.
BLACKOUT_MODE=0
# A device that is only on when the grid is: plugged into a socket the
# inverter does NOT back up (a TV box, a printer, the ISP router if it is not
# on the UPS). Give it a fixed IP in the router. Required when BLACKOUT_MODE=1.
BLACKOUT_SENTINEL_IP=192.168.0.50
# A TCP port to knock on. A refusal still counts as the device being up, but
# some devices drop rather than refuse - pick a port it actually listens on
# (80 for most web UIs) and check it with `python check.py`.
BLACKOUT_SENTINEL_PORT=80

# ---------------------------------------------------------------------------
# Site and array, for the Open-Meteo yield forecast (no API key needed).
# ---------------------------------------------------------------------------
LATITUDE=50.41771720976229
LONGITUDE=30.328260683770033
# Panel tilt from horizontal, and bearing as a compass angle (0 N, 180 S, 270 W).
PV_TILT=20
PV_AZIMUTH=240
PV_KWP=10
INVERTER_KW=12
# Lump sum for cell temperature, inverter losses, soiling and wiring. 0.75-0.85
# is the usual range; lower it if the model reads high against your real yield.
PV_PERFORMANCE_RATIO=0.8
# Seconds between forecast refetches.
FORECAST_REFRESH=3600

# What counts as a wet hour, and how much of the window must be wet to call
# the day rainy. Only used by BOOST_STRATEGY=rain.
RAIN_MM=0.1
RAIN_PROBABILITY=60
RAIN_HOURS_FRACTION=0.5

# Timezone for the log timestamps.
TZ=Europe/Kyiv

# ---------------------------------------------------------------------------
# History and dashboard. Every pass is written to a SQLite file and served as
# a live page, so last night's decisions can be read back instead of guessed.
# ---------------------------------------------------------------------------

# Where the file lives. In Docker this is the ./data volume from the compose
# file - keep it there, or an image update loses the history.
HISTORY_DB=data/history.db
# Days kept. Older rows are deleted once a day, on the hour the watcher
# started. 0 keeps everything forever - roughly 4 MB a month, 47 MB a year at
# the default sample interval.
HISTORY_RETENTION_DAYS=30
# Seconds between writes while nothing changes. Any change - the socket, the
# verdict - is written at once regardless; this only throttles the quiet
# stretches so the SD card is not written 1440 times a day for nothing.
HISTORY_SAMPLE_INTERVAL=300

# Keep reading the plug and the forecast outside both windows too. Nothing is
# switched then; it only means the charts cover the whole day. Set to 0 to
# read only when a decision is actually being made.
MONITOR_DAYTIME=1

# The dashboard: http://<this-host>:8080. Read-only and unauthenticated, so
# keep it on the LAN. Port 0 switches it off; 127.0.0.1 as the host makes it
# local to the machine only.
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# ngrok tunnel (optional): the dashboard on a public address, behind Google
# sign-in. Start it with: docker compose --profile ngrok up -d
# That page can pause the watcher, so the sign-in is not optional - only the
# Google accounts listed here get past ngrok's edge. Left unset, nobody does.
# ---------------------------------------------------------------------------
# From https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your-ngrok-auth-token
# The reserved domain from https://dashboard.ngrok.com/domains
# NGROK_DOMAIN=your-name.ngrok.app
# Who may sign in. Comma-separated for more than one.
# NGROK_OAUTH_EMAIL=you@gmail.com
